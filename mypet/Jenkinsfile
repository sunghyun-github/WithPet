pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/sunghyun-github/WithPet.git'
            }
        }
        stage('Build') {
            steps {
                dir('mypet') {
                    bat './gradlew build'
                }
            }
        }
        stage('Docker Build') {
            steps {
                dir('mypet') {
                    bat "docker-compose build"
                }
            }
        }
        stage('Docker Login') {
    steps {
        script {
            def dockerUsername = 'admin'  // Docker Hub 사용자명
            def dockerPassword = 'rpass'  // Docker Hub 비밀번호
            bat """
                echo ${dockerPassword} | docker login -u ${dockerUsername} --password-stdin
            """
        }
    }
}
        stage('Docker Push') {
            steps {
                script {
                    bat "docker tag myapp:latest myapp:latest"  // Tagging 이미지를 latest로 설정
                    bat "docker push myapp:latest"
                }
            }
        }
        stage('Docker Down') {
            steps {
                dir('mypet') {
                    bat 'docker-compose down'
                }
            }
        }
        stage('Docker Up') {
            steps {
                dir('mypet') {
                    script {
                        withCredentials([usernamePassword(credentialsId: 'mypet-db', 
                            usernameVariable: 'DB_USERNAME', passwordVariable: 'DB_PASSWORD')]) {
                            writeFile file: '.env', text: "DB_USERNAME=${DB_USERNAME}\nDB_PASSWORD=${DB_PASSWORD}"
                            bat 'docker-compose up -d'
                        }
                    }
                }
            }
        }
    }
}
