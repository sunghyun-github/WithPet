pipeline {
    agent any
    environment {
        DOCKER_IMAGE = 'myapp:latest'
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/sunghyun-github/WithPet.git'
            }
        }
        stage('Build') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat """
                        ./gradlew.bat build \
                        -Dspring.datasource.url=%SPRING_DATASOURCE_URL% \
                        -Dspring.datasource.username=%SPRING_DATASOURCE_USERNAME% \
                        -Dspring.datasource.password=%SPRING_DATASOURCE_PASSWORD%
                    """
                }
            }
        }
        stage('Test') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat """
                        ./gradlew.bat test \
                        -Dspring.datasource.url=%SPRING_DATASOURCE_URL% \
                        -Dspring.datasource.username=%SPRING_DATASOURCE_USERNAME% \
                        -Dspring.datasource.password=%SPRING_DATASOURCE_PASSWORD%
                    """
                }
            }
        }
        stage('Docker Build') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat 'docker build -t %DOCKER_IMAGE% .'
                }
            }
        }
        stage('Docker Deploy') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat 'docker-compose up -d'
                }
            }
        }
    }
}
