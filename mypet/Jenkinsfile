pipeline {
    agent any
    environment {
        DOCKER_IMAGE = "mypet:latest"
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/sunghyun-github/WithPet.git'
            }
        }
        stage('Build') {
            steps {
                script {
                    bat 'gradlew.bat build'
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    bat 'docker build -t %DOCKER_IMAGE% .'
                }
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    bat 'docker push %DOCKER_IMAGE%'
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    // Docker Compose로 컨테이너 실행
                    bat 'docker-compose up -d'
                }
            }
        }
    }
}
