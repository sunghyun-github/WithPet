pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/sunghyun-github/WithPet.git'
            }
        }
        stage('Build') {
            steps {
                dir('mypet') {
                    bat './gradlew build'
                }
            }
        }
        stage('Docker Build') {
            steps {
                dir('mypet') {
                    bat "docker-compose build"
                }
            }
        }
        stage('Docker Login') {
	    steps {
   		     script {
   	         // Jenkins 자격 증명에서 'docker-hub-credentials'을 불러와서 환경 변수로 설정
       		     withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', 
      	   	                                      usernameVariable: 'DOCKER_USERNAME', 
             	                                  passwordVariable: 'DOCKER_PASSWORD')]) {
        			        // Docker 로그인 명령어 실행
            		    bat "echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin"
        	  	 }
      		  	}
 		   }
		}

        stage('Docker Push') {
            steps {
                script {
                    bat "docker tag myapp:latest myapp:latest"  // Tagging 이미지를 latest로 설정
                    bat "docker push myapp:latest"
                }
            }
        }
        stage('Docker Down') {
            steps {
                dir('mypet') {
                    bat 'docker-compose down'
                }
            }
        }
        stage('Docker Up') {
            steps {
                dir('mypet') {
                    script {
                        withCredentials([usernamePassword(credentialsId: 'mypet-db', 
                            usernameVariable: 'DB_USERNAME', passwordVariable: 'DB_PASSWORD')]) {
                            writeFile file: '.env', text: "DB_USERNAME=${DB_USERNAME}\nDB_PASSWORD=${DB_PASSWORD}"
                            bat 'docker-compose up -d'
                        }
                    }
                }
            }
        }
    }
}
