pipeline {
    agent any
    environment {
        DOCKER_IMAGE = 'myapp:latest'
        DB_URL = 'jdbc:mysql://localhost:3306/mydb'  // MySQL 연결 URL
        DB_USERNAME = 'root'  // MySQL 사용자 이름
        DB_PASSWORD = 'rpass'  // MySQL 비밀번호
        DB_DRIVER = 'com.mysql.cj.jdbc.Driver'  // MySQL JDBC 드라이버
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/sunghyun-github/WithPet.git'
            }
        }
        stage('Build') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat 'gradlew.bat build'
                }
            }
        }
        stage('Test') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat 'gradlew.bat test'
                }
            }
        }
        stage('Docker Build') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat 'docker build -t %DOCKER_IMAGE% .'
                }
            }
        }
        stage('Docker Deploy') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat 'docker-compose up -d'
                }
            }
        }
    }
}
