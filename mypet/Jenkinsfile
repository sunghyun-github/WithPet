pipeline {
    agent any
    environment {
        // .env 파일을 로드하여 환경 변수 설정
        DOCKER_IMAGE = "mypet:latest"
    }
    stages {
        stage('Load .env') {
            steps {
                script {
                    bat 'for /f "tokens=*" %%i in (.env) do set %%i'
                }
            }
        }
        stage('Build') {
            steps {
                script {
                    bat './gradlew build'
                }
            }
        }
        stage('Docker Build') {
            steps {
                script {
                    bat 'docker build -t %DOCKER_IMAGE% .'
                }
            }
        }
        stage('Docker Push') {
            steps {
                script {
                    bat 'docker push %DOCKER_IMAGE%'
                }
            }
        }
        stage('Deploy') {
            steps {
                script {
                    bat 'docker-compose up -d'
                }
            }
        }
    }
}
