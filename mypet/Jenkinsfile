pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                bat 'gradlew build'
            }
        }
        stage('Docker Compose') {
            steps {
                bat '''
                docker-compose down
                docker-compose build
                docker-compose up -d
                '''
            }
        }
    }
    post {
        always {
            bat 'docker-compose logs'
            bat 'docker-compose down'
        }
    }
}
