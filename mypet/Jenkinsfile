pipeline {
    agent any
    environment {
        DOCKER_IMAGE = 'myapp:latest'  // Docker 이미지 이름 설정
        FILE_UPLOAD_DIR = credentials('file-upload-dir')  // Credentials에서 파일 업로드 경로 가져오기
    }
    stages {
        stage('Checkout') {
            steps {
                // GitHub 저장소에서 코드 체크아웃
                git branch: 'develop', url: 'https://github.com/sunghyun-github/WithPet.git'
            }
        }
        stage('Build') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat 'gradlew.bat build'  // Gradle 빌드 실행
                }
            }
        }
        stage('Test') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat 'gradlew.bat test'  // 테스트 실행
                }
            }
        }
        stage('Docker Build') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat "docker build -t ${env.DOCKER_IMAGE} ."  // Docker 이미지 빌드
                }
            }
        }
        stage('Docker Deploy') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    script {
                        // Credentials 활용하여 DB 사용자명과 비밀번호 설정
                        withCredentials([usernamePassword(credentialsId: 'mypet-db', 
                            usernameVariable: 'DB_USERNAME', passwordVariable: 'DB_PASSWORD')]) {
                            
                            // .env 파일 작성: DB_USERNAME, DB_PASSWORD, FILE_UPLOAD_DIR 설정
                            writeFile file: '.env', text: """
                            DB_USERNAME=${DB_USERNAME}
                            DB_PASSWORD=${DB_PASSWORD}
                            FILE_UPLOAD_DIR=${FILE_UPLOAD_DIR}  // 파일 업로드 경로 환경 변수 추가
                            """

                            // Docker Compose 실행
                            bat 'docker-compose up -d'
                        }
                    }
                }
            }
        }
    }
}
