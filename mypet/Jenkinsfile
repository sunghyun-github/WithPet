pipeline {
    agent any
    environment {
        DOCKER_IMAGE = "mypet:latest"
    }
    stages {
        stage('Build') {
            steps {
                script {
                    // Gradle 빌드
                    bat './gradlew build'
                }
            }
        }
        stage('Docker Build') {
            steps {
                script {
                    // Docker 이미지 빌드
                    bat 'docker build -t %DOCKER_IMAGE% .'
                }
            }
        }
        stage('Docker Push') {
            steps {
                script {
                    bat 'docker push %DOCKER_IMAGE%'
                }
            }
        }
        stage('Deploy') {
            steps {
                script {
                    bat 'docker-compose up -d'
                }
            }
        }
    }
}
