pipeline {
    agent any
    environment {
        DB_USERNAME = ''
        DB_PASSWORD = ''
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/sunghyun-github/WithPet.git'
            }
        }
        stage('Docker Build') {
            steps {
                dir('mypet') {
                    script {
                        bat 'docker-compose build --no-cache'
                    }
                }
            }
        }
        stage('Docker Up') {
            steps {
                dir('mypet') {
                    script {
                        withCredentials([usernamePassword(credentialsId: 'mypet-db', 
                            usernameVariable: 'DB_USERNAME', passwordVariable: 'DB_PASSWORD')]) {
                            
                            writeFile file: '.env', text: "DB_USERNAME=${DB_USERNAME}\nDB_PASSWORD=${DB_PASSWORD}"
                            
                            // 강제로 컨테이너 재시작하고 실행
                            bat 'docker-compose up -d --force-recreate'
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            // 컨테이너 종료가 필요한 경우만 수행하도록 설정
            script {
                // 필요에 따라 이 부분을 사용하여 컨테이너 종료
                // 예: bat 'docker-compose down'
            }
        }
    }
}
