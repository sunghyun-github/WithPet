pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                // GitHub에서 코드 클론
                git branch: 'develop', url: 'https://github.com/sunghyun-github/WithPet.git'
            }
        }
        stage('Build') {
            steps {
                // 빌드 실행
                bat 'gradlew.bat build'
            }
        }
        stage('Test') {
            steps {
                // 테스트 실행
                bat 'gradlew.bat test'
            }
        }
        stage('Success') {
            steps {
                echo 'CI/CD pipeline 실행 성공!'
            }
        }
    }
}
