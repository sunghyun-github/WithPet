pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/sunghyun-github/WithPet.git'
            }
        }
        stage('Build') {
            steps {
                dir('mypet') {
                    bat './gradlew build'
                }
            }
        }
        stage('Docker Build') {
            steps {
                dir('mypet') {
                    bat "docker-compose build --no-cache"  // --no-cache로 캐시 무시하고 새로 빌드
                }
            }
        }
        stage('Docker Down') {
            steps {
                dir('mypet') {
                    bat 'docker-compose down'
                }
            }
        }
        stage('Docker Up') {
            steps {
                dir('mypet') {
                    script {
                        withCredentials([usernamePassword(credentialsId: 'mypet-db', 
                            usernameVariable: 'DB_USERNAME', passwordVariable: 'DB_PASSWORD')]) {
                            writeFile file: '.env', text: "DB_USERNAME=${DB_USERNAME}\nDB_PASSWORD=${DB_PASSWORD}"
                            bat 'docker-compose up -d --force-recreate'  // 컨테이너 강제로 재시작
                        }
                    }
                }
            }
        }
    }
}
