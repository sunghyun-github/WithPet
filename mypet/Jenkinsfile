pipeline {
    agent any
    environment {
        DOCKER_IMAGE = 'myapp:latest'
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/sunghyun-github/WithPet.git'
            }
        }
        stage('Build') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat """
                        ./gradlew.bat build ^
                        -Dspring.datasource.url="jdbc:mysql://localhost:3306/fpjt?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8" ^
                        -Dspring.datasource.username="root" ^
                        -Dspring.datasource.password="rpass"
                    """
                }
            }
        }
        stage('Test') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat """
                        ./gradlew.bat test ^
                        -Dspring.datasource.url="jdbc:mysql://localhost:3306/fpjt?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8" ^
                        -Dspring.datasource.username="root" ^
                        -Dspring.datasource.password="rpass"
                    """
                }
            }
        }
        stage('Docker Build') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat 'docker build -t %DOCKER_IMAGE% .'
                }
            }
        }
        stage('Docker Deploy') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat 'docker-compose up -d'
                }
            }
        }
    }
}
