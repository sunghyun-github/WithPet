pipeline {
    agent any
    environment {
        DOCKER_IMAGE = 'myapp:latest'  // Docker 이미지 이름 설정
    }
    stages {
        stage('Checkout') {
            steps {
                // GitHub 저장소에서 코드 체크아웃
                git branch: 'develop', url: 'https://github.com/sunghyun-github/WithPet.git'
            }
        }
        stage('Build') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat './gradlew.bat build'  // Gradle 빌드 실행
                }
            }
        }
        stage('Test') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat './gradlew.bat test'  // 테스트 실행
                }
            }
        }
        stage('Docker Build') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    bat "docker build --no-cache -t ${env.DOCKER_IMAGE} ."  // Docker 이미지 재빌드 (캐시 사용 안 함)
                }
            }
        }
        stage('Docker Deploy') {
            steps {
                dir('mypet') {  // 'mypet' 폴더로 이동
                    script {
                        // Credentials 활용하여 환경 변수 설정
                        withCredentials([usernamePassword(credentialsId: 'mypet-db', 
                            usernameVariable: 'DB_USERNAME', passwordVariable: 'DB_PASSWORD')]) {
                            // .env 파일 작성
                            writeFile file: '.env', text: "DB_USERNAME=${DB_USERNAME}\nDB_PASSWORD=${DB_PASSWORD}"
                            // 기존 컨테이너 종료 후 새로운 이미지를 빌드하여 컨테이너 시작
                            bat 'docker-compose up --build -d'  // 새로 빌드한 이미지를 사용해 컨테이너 시작
                        }
                    }
                }
            }
        }
    }
}
